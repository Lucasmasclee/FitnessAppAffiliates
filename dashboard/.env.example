# Copy to .env and fill in (never commit .env).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Prefer a valid service_role key (bypasses RLS).
# If unavailable, anon works AFTER you run sql/dashboard_acquisition_funnel.sql.
SUPABASE_ANON_KEY=YOUR_ANON_KEY
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# App Store Connect Analytics API (Source Type = App Store search)
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ASC_KEY_ID=XXXXXXXXXX
ASC_APP_ID=1234567890
ASC_PRIVATE_KEY_PATH=credentials/AuthKey_XXXXXXXXXX.p8

DASHBOARD_PORT=4000
